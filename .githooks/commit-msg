#!/usr/bin/env bash
# ==============================================================================
#   42 FT_LINEAR_REGRESSION — DYNAMIC TASK & CONVENTIONAL COMMIT LINTER HOOK
# ==============================================================================

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge commits and rebase messages without validation
if [[ "$COMMIT_MSG" =~ ^Merge ]] || [[ "$COMMIT_MSG" =~ ^Revert ]] || [[ "$COMMIT_MSG" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
    exit 0
fi

# Regex: <type>(<scope>): [<TASK-ID>:#<ISSUE_NUM>] <description> or standard conventional commit
COMMIT_REGEX="^([^:]* )?(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\/-]+\))?:[[:space:]]+(\[([a-zA-Z0-9_:#-]+)\])?[[:space:]]+(.+)$"

if ! [[ "$COMMIT_MSG" =~ $COMMIT_REGEX ]]; then
    echo ""
    echo "========================================================================"
    echo " ⛔ COMMIT REJEITADO: MENSAGEM FORA DO PADRÃO INSTITUCIONAL 42"
    echo "========================================================================"
    echo " ❌ Sua mensagem: \"$COMMIT_MSG\""
    echo ""
    echo " 📐 Formato Obrigatório:"
    echo "    <type>(<scope>): [<TASK-ID>:#<ISSUE_NUM>] <descrição da alteração>"
    echo "    ou: <type>(<scope>): [<TASK-ID>] <descrição da alteração>"
    echo ""
    echo " 📌 Exemplos Válidos:"
    echo "    feat(preprocessing): [LR-01:#1] implement minmax scaler from scratch"
    echo "    feat(model): [LR-02:#2] implement gradient descent optimization"
    echo "    docs(theory): [LR-06:#6] derive gradient and loss functions"
    echo "    chore(build): [INFRA] configure pre-commit and ast norm checker"
    echo ""
    echo " 💡 Tipos Válidos:"
    echo "    feat, fix, docs, test, refactor, perf, build, ci, chore"
    echo "========================================================================"
    exit 1
fi

# Extract the Raw Task Tag inside brackets [TAG] (e.g. LR-01:#1 or LR-01)
RAW_TASK_TAG="${BASH_REMATCH[5]}"
TASK_TAG=$(echo "$RAW_TASK_TAG" | cut -d':' -f1)

# Reserved global tags that don't need a matching file in .github/issues/
RESERVED_TAGS=("INFRA" "CHORE" "DOCS" "FIX" "HOTFIX" "GLOBAL" "CONFIG" "SECURITY" "COMMUNITY" "DEPS")

if [ -n "$TASK_TAG" ]; then
    UPPER_TAG=$(echo "$TASK_TAG" | tr '[:lower:]' '[:upper:]')

    # Check if it's a reserved tag
    for reserved in "${RESERVED_TAGS[@]}"; do
        if [ "$UPPER_TAG" == "$reserved" ]; then
            exit 0
        fi
    done

    # Dynamic validation: Check if task exists in .github/issues/
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    ISSUES_DIR="$SCRIPT_DIR/../.github/issues"

    LOWER_TAG=$(echo "$TASK_TAG" | tr '[:upper:]' '[:lower:]')
    MATCHING_TASK=$(find "$ISSUES_DIR" -maxdepth 1 -iname "*${LOWER_TAG}*" 2>/dev/null | head -n 1)

    if [ -z "$MATCHING_TASK" ] && [ -d "$ISSUES_DIR" ]; then
        echo ""
        echo "========================================================================"
        echo " ⛔ COMMIT REJEITADO: TASK NÃO ENCONTRADA NO PROJETO"
        echo "========================================================================"
        echo " ❌ A task \"[$TASK_TAG]\" não existe na pasta .github/issues/."
        echo ""
        echo " 📋 Tasks válidas encontradas localmente:"
        for f in "$ISSUES_DIR"/*.md; do
            if [ -f "$f" ]; then
                BASENAME=$(basename "$f" .md)
                echo "    - $BASENAME"
            fi
        done
        echo ""
        echo " 💡 O que fazer:"
        echo "    1. Se for uma task do subject, verifique o ID correto (ex: LR-01 a LR-08);"
        echo "    2. Se for uma nova task, crie o arquivo .github/issues/lr-XX-nome.md;"
        echo "    3. Se for uma alteração geral sem task, use uma tag reservada:"
        echo "       [INFRA], [CHORE], [DOCS], [HOTFIX], [SECURITY], [GLOBAL]"
        echo "========================================================================"
        exit 1
    fi
fi

exit 0
